{"audit_relevance": 1.0, "authority": 1.0, "captured_at": "2026-08-23T10:51:16.649Z", "claim_type": "reasoning_behavior", "comparison_models": ["claude-opus-4-8", "claude-mythos-5", "claude-sonnet-5"], "content_hash": "7084e3186c8a809b9f54bff840a51a48fa0ae2c28098b17333142b25039f8530", "contrast_signal": "声称返回完整原始思维链，或不识别两种显示模式，可能是非目标接口。", "discriminative_power": 0.82, "effective_from": "2026-06-09", "eligible_for_ground_truth": true, "embedding_text": "模型：Claude Fable 5\n审计属性：思考内容可见性\n预期信号：不会返回原始思维链；thinking.display 仅支持 summarized 或 omitted。\n对比信号：声称返回完整原始思维链，或不识别两种显示模式，可能是非目标接口。\n测量方法：检查 thinking block 结构和 display 模式，不能以模型自报名称评分。\n测试配置：同一推理题分别设置 summarized 与 omitted，各运行 3 次。", "estimated_cost": 0.35, "evidence_chain": [{"audit_record_id": "fable5-thinking-visibility", "captured_at": "2026-08-23T10:51:16.649Z", "evidence_chunk_id": "chunk-bc4a6aec7cb05ecb21f6", "source_id": "02-claude-docs-introduction", "source_url": "https://platform.claude.com/docs/en/about-claude/models/introducing-claude-fable-5-and-claude-mythos-5"}], "evidence_chunk_ids": ["chunk-bc4a6aec7cb05ecb21f6"], "evidence_verified": true, "expected_signal": "不会返回原始思维链；thinking.display 仅支持 summarized 或 omitted。", "fallback_contaminated": false, "id": "attr-fable5-thinking-visibility", "measurement": "检查 thinking block 结构和 display 模式，不能以模型自报名称评分。", "minimum_runs": 6, "model_family": "claude", "model_id": "claude-fable-5", "model_version": "5", "policy_decision": "admit", "quarantine_reason": "", "record_type": "attribute", "source_claim_ids": ["fable5-thinking-visibility"], "source_id": "02-claude-docs-introduction", "source_level": "P0", "source_urls": ["https://platform.claude.com/docs/en/about-claude/models/introducing-claude-fable-5-and-claude-mythos-5"], "spoofability": 0.54, "stability": 0.91, "subject_model": "claude-fable-5", "surface": "claude_api", "test_config": "同一推理题分别设置 summarized 与 omitted，各运行 3 次。", "testability": 0.94, "title": "思考内容可见性", "watering_types": ["api_contract_mismatch", "mod