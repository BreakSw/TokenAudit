{"audit_relevance": 1.0, "authority": 1.0, "captured_at": "2026-08-23T10:51:16.649Z", "claim_type": "reasoning_behavior", "comparison_models": ["claude-opus-4-8", "claude-mythos-5", "claude-sonnet-5"], "content_hash": "dde3b9c2a188416a599b0d456e8903b63813f4068ffea6bd94c87982d7bbc369", "contrast_signal": "接受并真实关闭 thinking，或完全忽略 effort 行为，可能表明接口/模型不匹配。", "discriminative_power": 0.87, "effective_from": "2026-06-09", "eligible_for_ground_truth": true, "embedding_text": "模型：Claude Fable 5\n审计属性：Adaptive Thinking 强制开启\n预期信号：thinking.disabled 不受支持，推理深度应由 effort 控制。\n对比信号：接受并真实关闭 thinking，或完全忽略 effort 行为，可能表明接口/模型不匹配。\n测量方法：对 thinking.disabled 与多个 effort 值执行协议测试，比较错误字段和输出预算。\n测试配置：固定提示和采样参数，每个 effort 至少 3 次。", "estimated_cost": 0.45, "evidence_chain": [{"audit_record_id": "fable5-adaptive-thinking", "captured_at": "2026-08-23T10:51:16.649Z", "evidence_chunk_id": "chunk-bc4a6aec7cb05ecb21f6", "source_id": "02-claude-docs-introduction", "source_url": "https://platform.claude.com/docs/en/about-claude/models/introducing-claude-fable-5-and-claude-mythos-5"}], "evidence_chunk_ids": ["chunk-bc4a6aec7cb05ecb21f6"], "evidence_verified": true, "expected_signal": "thinking.disabled 不受支持，推理深度应由 effort 控制。", "fallback_contaminated": false, "id": "attr-fable5-adaptive-thinking", "measurement": "对 thinking.disabled 与多个 effort 值执行协议测试，比较错误字段和输出预算。", "minimum_runs": 9, "model_family": "claude", "model_id": "claude-fable-5", "model_version": "5", "policy_decision": "admit", "quarantine_reason": "", "record_type": "attribute", "source_claim_ids": ["fable5-adaptive-thinking"], "source_id": "02-claude-docs-introduction", "source_level": "P0", "source_urls": ["https://platform.claude.com/docs/en/about-claude/models/introducing-claude-fable-5-and-claude-mythos-5"], "spoofability": 0.5, "stability": 0.9, "subject_model": "claude-fable-5", "surface": "claude_api", "test_config": "固定提示和采样参数，每个 effort 至少 3 次。", "testability": 0.95, "title": "Adaptive Thinking 强制开启", "watering_types": ["reasoning_budg