# 审计 AI 的 API Key、URL 和模型请在前端“设置”中配置，后端会加密存入 Redis。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=2048

BACKEND_API_KEY=
APP_ENVIRONMENT=development
BACKEND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_FILE=../data/token-encryption.key
AUDIT_ALLOW_PRIVATE_TARGETS=false
AUDIT_MAX_CONCURRENCY=4
AUDIT_QUEUE_CAPACITY=20
AUDIT_PROCESS_TIMEOUT_SECONDS=7200
AUDIT_REQUEST_TIMEOUT_S=600
# DNS 完整性诊断仅用于提示，不会阻断审计。默认关闭，设为 true 可显示诊断事件。
AUDIT_DNS_INTEGRITY_CHECK=false
PYTHON_EXECUTABLE=python
AUDIT_CORE_WORKDIR=../audit-core
AUDIT_EXPORT_FORMATS=json,md,xlsx

VITE_BACKEND_BASE_URL=http://localhost:8086

# 深度审计知识库。Windows 无 Docker 模式默认存入项目的 data/milvus/。
# 生产环境若使用独立 Milvus 服务，再改为 http://milvus-host:19530。
RAG_ENABLED=true
MILVUS_URI=./data/milvus/tokenaudit.db
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=tokenaudit_knowledge_v4
MILVUS_BEHAVIOR_COLLECTION=tokenaudit_behavior_v1
MILVUS_METRIC_TYPE=COSINE

# Embedding 服务。API Key 只写入本地 .env，不要提交。
EMBEDDING_BASE_URL=https://api.voyageai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-code-3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60

# Voyage Rerank；未单独配置 Key 时，知识服务会复用 EMBEDDING_API_KEY。
RERANK_BASE_URL=https://api.voyageai.com/v1
RERANK_API_KEY=
RERANK_MODEL=rerank-2.5
RERANK_TIMEOUT_SECONDS=60

# RAG：Milvus 先召回 12 条，Voyage Rerank 后保留 5 条。
RAG_RETRIEVAL_TOP_K=12
RAG_RERANK_TOP_K=5
RAG_BEHAVIOR_RETRIEVAL_TOP_K=20
RAG_BEHAVIOR_RERANK_TOP_K=8
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8091
KNOWLEDGE_SERVICE_TIMEOUT_SECONDS=120

# Unstructured by_title：标题边界优先，仅在超长块硬切分时重叠 120 字符。
RAG_CHUNK_MAX_CHARACTERS=1800
RAG_CHUNK_NEW_AFTER_CHARACTERS=1200
RAG_CHUNK_COMBINE_UNDER_CHARACTERS=300
RAG_CHUNK_OVERLAP_CHARACTERS=120
UNSTRUCTURED_HI_RES_MODEL=yolox
TESSERACT_EXECUTABLE=D:/download/OCR/tesseract.exe
TESSDATA_PREFIX=D:/download/OCR/tessdata
OCR_LANGUAGES=eng
